# Shubham Super Shopee — Storefront environment
# Copy values from your Supabase + deployment notes. NEVER commit real secrets.
# On Vercel: Project → Settings → Environment Variables (same names, no "export").

# ── Database (REQUIRED — without these every /api/* returns 503) ────────────
# Supabase PostgreSQL — transaction pooler (port 6543) for the app runtime:
SHOP_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20
# Session/direct connection (port 5432) — used only for migrations (prisma db push):
SHOP_DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── ERP integration (optional in sandbox; required for order push to ERP) ───
# ERP_API_URL=https://<your-erp-app>.vercel.app/api
ERP_SYNC_TOKEN=change-me-shared-secret

# ── Store identity (shown in header/footer/checkout) ───────────────────────
NEXT_PUBLIC_STORE_NAME=Shubham Super Shopee
NEXT_PUBLIC_STORE_PHONE=+91 98765 43210
NEXT_PUBLIC_STORE_ADDRESS=Pune, Maharashtra, India
NEXT_PUBLIC_UPI_ID=store@upi

# ── Health check ────────────────────────────────────────────────────────────
# After deploying, open /api/health — it reports which of the above are set
# and whether the database is reachable (no secrets are exposed).
